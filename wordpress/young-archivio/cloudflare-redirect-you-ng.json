{"rules": [{"description": "Vecchi articoli blog/news/culture -> young.it/archivio", "expression": "(http.host in {\"blog.you-ng.it\" \"news.you-ng.it\" \"culture.you-ng.it\"} and http.request.uri.path wildcard r\"/20*/*/*/*\" and not http.request.uri.path contains \"/wp-content/\")", "action": "redirect", "action_parameters": {"from_value": {"preserve_query_string": false, "status_code": 301, "target_url": {"expression": "wildcard_replace(http.request.uri.path, r\"/*\", r\"https://young.it/archivio/${1}\")"}}}, "enabled": true}, {"description": "Resto di blog.you-ng.it -> sezione blog", "expression": "(http.host eq \"blog.you-ng.it\")", "action": "redirect", "action_parameters": {"from_value": {"status_code": 301, "target_url": {"value": "https://young.it/archivio/category/blog/"}, "preserve_query_string": false}}, "enabled": true}, {"description": "Resto di news.you-ng.it -> sezione news", "expression": "(http.host eq \"news.you-ng.it\")", "action": "redirect", "action_parameters": {"from_value": {"status_code": 301, "target_url": {"value": "https://young.it/archivio/category/news/"}, "preserve_query_string": false}}, "enabled": true}, {"description": "Resto di culture.you-ng.it -> sezione culture", "expression": "(http.host eq \"culture.you-ng.it\")", "action": "redirect", "action_parameters": {"from_value": {"status_code": 301, "target_url": {"value": "https://young.it/archivio/category/culture/"}, "preserve_query_string": false}}, "enabled": true}]}
